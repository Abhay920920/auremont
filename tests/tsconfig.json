{
  "extends": "../auremont-backend/tsconfig.json",
  "compilerOptions": {
    "rootDir": "../",
    "baseUrl": "./",
    "jsx": "react-jsx",
    "paths": {
      "src/*": ["../auremont-backend/src/*"],
      "@/*": ["../auremont-frontend/*"]
    },
    "typeRoots": [
      "../node_modules/@types",
      "../auremont-backend/node_modules/@types"
    ],
    "types": ["jest", "node", "bcrypt"],
    "moduleResolution": "node"
  },
  "include": ["../auremont-backend/src/**/*.ts", "**/*.ts", "../auremont-frontend/**/*.ts", "../auremont-frontend/**/*.tsx"]
}
