# ============================================================
# AUREMONT LUXURY PLATFORM — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (use connection pooler in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ── Application ───────────────────────────────────────────────
NODE_ENV="development"          # development | production
PORT=3001
FRONTEND_URL="http://localhost:3000"   # Production: https://yourdomain.com

# ── JWT Authentication ────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_64_CHAR_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_STRONG_RANDOM_64_CHAR_SECRET"

# ── Cookies ───────────────────────────────────────────────────
# Set to "true" in production (requires HTTPS). Leave unset or "false" for local dev.
COOKIE_SECURE="false"

# ── Razorpay Payment Gateway ──────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXX"
RAZORPAY_KEY_SECRET="XXXXXXXXXXXXXXXXXXXXXXXXXX"
# Get from: https://dashboard.razorpay.com/app/webhooks
RAZORPAY_WEBHOOK_SECRET="REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET"

# ── Email / SMTP (for password resets, order confirmations) ──
SMTP_HOST="smtp.yourmailprovider.com"
SMTP_PORT="587"
SMTP_USER="noreply@yourdomain.com"
SMTP_PASS="REPLACE_WITH_SMTP_PASSWORD"
SMTP_FROM="Auremont <noreply@yourdomain.com>"

# ── Redis Cache (optional — for session / rate limiting) ──────
REDIS_URL="redis://localhost:6379"

# ── AWS S3 (for production image uploads) ────────────────────
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="REPLACE_WITH_AWS_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="REPLACE_WITH_AWS_SECRET_KEY"
AWS_S3_BUCKET="auremont-uploads-production"
