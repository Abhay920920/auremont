{
  "name": "auremont-monorepo",
  "version": "1.0.0",
  "workspaces": [
    "auremont-frontend",
    "auremont-backend"
  ],
  "devDependencies": {
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/testing": "^11.1.18",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "6.12.6",
    "bcrypt": "^6.0.0",
    "jest": "^29.0.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.0.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@nestjs/jwt": "^10.0.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": "tests/tsconfig.json"
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.spec.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/auremont-frontend/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/auremont-frontend/",
      "/auremont-backend/"
    ]
  },
  "scripts": {
    "build": "cd auremont-frontend && next build",
    "dev": "cd auremont-frontend && next dev",
    "start": "cd auremont-frontend && next start",
    "dev:backend": "cd auremont-backend && npm run dev",
    "build:backend": "cd auremont-backend && npm run build",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "jest --passWithNoTests",
    "test:security": "jest --config tests/security/jest.security.config.js",
    "test:integration": "npx jest tests/integration/ --config auremont-backend/package.json --passWithNoTests",
    "test:concurrency": "npx jest tests/concurrency/ --config auremont-backend/package.json --passWithNoTests"
  },
  "overrides": {
    "formidable": "3.5.3",
    "multer": "2.2.0",
    "file-type": "21.3.2",
    "qs": "6.15.2",
    "body-parser": "1.20.6",
    "glob": "10.5.0",
    "picomatch": "4.0.4",
    "tmp": "0.2.6",
    "webpack": "5.104.1",
    "postcss": "8.5.23"
  }
}
