{
  "name": "auremont-monorepo",
  "version": "1.0.0",
  "devDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.0.0",
    "bcrypt": "^6.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  },
  "dependencies": {
    "@nestjs/jwt": "^10.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.spec.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/auremont-frontend/",
      "/auremont-backend/"
    ]
  },
  "scripts": {
    "build": "cd auremont-frontend && npm run build",
    "dev": "cd auremont-frontend && npm run dev",
    "start": "cd auremont-frontend && npm run start",
    "dev:backend": "cd auremont-backend && npm run dev",
    "build:backend": "cd auremont-backend && npm run build",
    "test": "jest --passWithNoTests",
    "test:security": "jest --config tests/security/jest.security.config.js",
    "test:integration": "npx jest tests/integration/ --config auremont-backend/package.json --passWithNoTests",
    "test:concurrency": "npx jest tests/concurrency/ --config auremont-backend/package.json --passWithNoTests"
  }
}
