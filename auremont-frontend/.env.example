# Auremont Frontend — Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================
# SITE CONFIGURATION
# ============================================================
# The public URL of your deployed site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://auremont.com

# ============================================================
# API
# ============================================================
# URL of the backend API
NEXT_PUBLIC_API_URL=https://api.auremont.com

# ============================================================
# PAYMENT GATEWAY - RAZORPAY
# ============================================================
# Your Razorpay Key ID (starts with rzp_live_ for production)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
